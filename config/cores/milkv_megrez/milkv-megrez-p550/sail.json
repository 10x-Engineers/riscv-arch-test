        "maskmax6": 63,
        // Whether an address selection matches all the accessed addresses.
        // If set to `false`, it matches only the lowest address.
        "address_select_matches_all_addresses": true,
        // Maximum length of a chain. This cannot exceed the number of
        // triggers.  A value of 0 implies chains are not supported.
        "max_chain_length": 4
      },
      "textra": {
        // Which context matches are supported. Writes of unsupported
        // `mhselect` and `sselect` values are legalized to 0 (ignore).
        "mhselect": {
          // Values 1, 4 and 5, match on `mcontext`. Requires the
          // `mcontext` CSR. Values 1 and 5 also require H.
          "mcontext_match": false,
          // Values 2 and 6, match on the VMID in `hgatp`. Requires H.
          "vmid_match": false
        },
        "sselect": {
          // Value 1, match on `scontext`. Requires S and the `scontext`
          // CSR.
          "scontext_match": false,
          // Value 2, match on the ASID in `satp` or `vsatp`. Requires S.
          "asid_match": true
        },
        // The number of implemented `mhvalue` and `svalue` bits. Bits
        // above these are read only zero. At most 6 and 16 on RV32,
        // 13 and 32 on RV64.
        "mhvalue_len": 13,
        "svalue_len": 32
